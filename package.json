{
  "name": "treeate-copilot",
  "displayName": "TreeATE Copilot",
  "description": "%extension.description%",
  "version": "0.1.0",
  "publisher": "WilliamYinwei",
  "license": "MIT",
  "engines": { "vscode": "^1.115.0" },
  "categories": ["Testing", "Other"],
  "activationEvents": ["onStartupFinished", "workspaceContains:**/*.tpx", "workspaceContains:**/*.tp"],
  "main": "./out/extension.js",
  "icon": "./treeatelogo.png",
  "contributes": {
    "viewsContainers": {
      "activitybar": [{ "id": "treeate", "title": "TreeATE", "icon": "media/treeate.svg" }]
    },
    "views": {
      "treeate": [
        { "id": "treeate.projectTree", "name": "%view.projectTree%" },
        { "id": "treeate.parameterTable", "name": "%view.parameterTable%", "type": "webview" }
      ]
    },
    "customEditors": [
      {
        "viewType": "treeate.dllFunctions",
        "displayName": "%customEditor.dllFunctions%",
        "selector": [{ "filenamePattern": "**/libs/*.[dD][lL][lL]" }],
        "priority": "default"
      }
    ],
    "commands": [
      { "command": "treeate.newProject", "title": "%command.newProject%", "icon": "$(new-folder)" },
      { "command": "treeate.openProject", "title": "%command.openProject%", "icon": "$(folder-opened)" },
      { "command": "treeate.refresh", "title": "%command.refresh%", "icon": "$(refresh)" },
      { "command": "treeate.expandAll", "title": "%command.expandAll%", "icon": "$(expand-all)" },
      { "command": "treeate.addChild", "title": "%command.addChild%", "icon": "$(add)" },
      { "command": "treeate.insertSibling", "title": "%command.insertSibling%" },
      { "command": "treeate.deleteNode", "title": "%command.deleteNode%", "icon": "$(trash)" },
      { "command": "treeate.renameNode", "title": "%command.renameNode%", "icon": "$(edit)" },
      { "command": "treeate.importResource", "title": "%command.importResource%", "icon": "$(cloud-download)" },
      { "command": "treeate.importParameterCsv", "title": "%command.importParameterCsv%", "icon": "$(cloud-download)" },
      { "command": "treeate.exportParameterCsv", "title": "%command.exportParameterCsv%", "icon": "$(cloud-upload)" },
      { "command": "treeate.openProperties", "title": "%command.openProperties%", "icon": "$(settings-gear)" },
      { "command": "treeate.openScript", "title": "%command.openScript%", "icon": "$(code)" },
      { "command": "treeate.openSetup", "title": "%command.openSetup%" },
      { "command": "treeate.openTeardown", "title": "%command.openTeardown%" },
      { "command": "treeate.generateFunctions", "title": "%command.generateFunctions%" },
      { "command": "treeate.runProject", "title": "%command.runProject%", "icon": "$(debug-start)" }
    ],
    "menus": {
      "view/title": [
        { "command": "treeate.newProject", "when": "view == treeate.projectTree", "group": "navigation@1" },
        { "command": "treeate.openProject", "when": "view == treeate.projectTree", "group": "navigation@2" },
        { "command": "treeate.runProject", "when": "view == treeate.projectTree && treeate.projectOpen", "group": "navigation@3" },
        { "command": "treeate.refresh", "when": "view == treeate.projectTree", "group": "navigation@4" },
        { "command": "treeate.expandAll", "when": "view == treeate.projectTree && treeate.projectOpen", "group": "navigation@5" }
      ],
      "view/item/context": [
        { "command": "treeate.addChild", "when": "view == treeate.projectTree && viewItem == treeate.project", "group": "1_edit@1" },
        { "command": "treeate.addChild", "when": "view == treeate.projectTree && viewItem == treeate.suite", "group": "1_edit@1" },
        { "command": "treeate.insertSibling", "when": "view == treeate.projectTree && viewItem != treeate.project", "group": "1_edit@2" },
        { "command": "treeate.renameNode", "when": "view == treeate.projectTree", "group": "1_edit@3" },
        { "command": "treeate.deleteNode", "when": "view == treeate.projectTree && viewItem != treeate.project", "group": "1_edit@4" },
        { "command": "treeate.openScript", "when": "view == treeate.projectTree", "group": "2_open@2" },
        { "command": "treeate.openSetup", "when": "view == treeate.projectTree && viewItem != treeate.case", "group": "3_script@1" },
        { "command": "treeate.openTeardown", "when": "view == treeate.projectTree && viewItem != treeate.case", "group": "3_script@2" },
        { "command": "treeate.generateFunctions", "when": "view == treeate.projectTree", "group": "3_script@3" },
        { "command": "treeate.importResource", "when": "view == treeate.projectTree", "group": "4_resource@1" },
        { "command": "treeate.importParameterCsv", "when": "view == treeate.projectTree && viewItem == treeate.project", "group": "4_resource@2" },
        { "command": "treeate.exportParameterCsv", "when": "view == treeate.projectTree && viewItem == treeate.project", "group": "4_resource@3" }
      ],
      "explorer/context": [
        { "command": "treeate.newProject", "when": "explorerResourceIsFolder", "group": "treeate@1" },
        { "command": "treeate.importResource", "when": "explorerResourceIsFolder", "group": "treeate@3" }
      ]
    },
    "keybindings": [
      { "command": "treeate.runProject", "key": "f5", "when": "treeate.projectOpen" },
      { "command": "treeate.renameNode", "key": "f2", "when": "view == treeate.projectTree && treeView.treeate.projectTree.focus" },
      { "command": "treeate.deleteNode", "key": "delete", "when": "view == treeate.projectTree && treeView.treeate.projectTree.focus" }
    ],
    "configurationDefaults": {
      "files.associations": {
        "*.tp": "json",
        "*.tpx": "json"
      }
    },
    "configuration": {
      "title": "TreeATE Copilot",
      "properties": {
        "treeate.testEnginePath": {
          "type": "string",
          "default": "",
          "description": "%config.testEnginePath.description%"
        },
        "treeate.testEngineArguments": {
          "type": "array",
          "items": { "type": "string" },
          "default": ["${tpx}"],
          "description": "%config.testEngineArguments.description%"
        },
        "treeate.qtInspectorPath": {
          "type": "string",
          "default": "",
          "description": "%config.qtInspectorPath.description%"
        },
        "treeate.openScriptOnSelect": {
          "type": "boolean",
          "default": true,
          "description": "%config.openScriptOnSelect.description%"
        },
        "treeate.language": {
          "type": "string",
          "enum": ["auto", "zh-cn", "en"],
          "enumDescriptions": ["%config.language.auto%", "%config.language.zh%", "%config.language.en%"],
          "default": "auto",
          "description": "%config.language.description%"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "build:qt-inspector": "cmake -S native -B native/build && cmake --build native/build --config Release",
    "watch": "tsc --watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src --ext .ts",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.19.21",
    "@types/vscode": "^1.85.0",
    "@vscode/test-cli": "^0.0.11",
    "@vscode/test-electron": "^2.5.2",
    "eslint": "^9.39.3",
    "mocha": "^11.7.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.56.1"
  },
  "dependencies": {}
}
